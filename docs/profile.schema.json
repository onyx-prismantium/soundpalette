{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SoundPalette palette profile (profile_version 1, .sppal.json)",
  "type": "object",
  "required": ["profile_version", "mapping_version", "name", "stats", "cov"],
  "definitions": {
    "dimStats": {
      "type": "object",
      "required": ["mean", "std", "min", "max"],
      "properties": {
        "mean": { "type": "number" },
        "std": { "type": "number", "minimum": 0 },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "stats7": {
      "type": "object",
      "required": ["bright01", "warm01", "ton01", "atk01", "tail01", "loud01", "jitter01"],
      "properties": {
        "bright01": { "$ref": "#/definitions/dimStats" },
        "warm01": { "$ref": "#/definitions/dimStats" },
        "ton01": { "$ref": "#/definitions/dimStats" },
        "atk01": { "$ref": "#/definitions/dimStats" },
        "tail01": { "$ref": "#/definitions/dimStats" },
        "loud01": { "$ref": "#/definitions/dimStats" },
        "jitter01": { "$ref": "#/definitions/dimStats" }
      }
    },
    "cov7": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "array",
        "minItems": 7,
        "maxItems": 7,
        "items": { "type": "number" }
      }
    }
  },
  "properties": {
    "profile_version": { "const": 1 },
    "mapping_version": { "type": "integer" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "threshold": { "type": "number", "exclusiveMinimum": 0 },
    "created_from": {
      "type": "object",
      "properties": {
        "type": { "enum": ["folder", "manifest", "selection"] },
        "root": { "type": "string" },
        "file_count": { "type": "integer", "minimum": 0 }
      }
    },
    "stats": { "$ref": "#/definitions/stats7" },
    "cov": { "$ref": "#/definitions/cov7" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "match", "stats", "cov"],
        "properties": {
          "name": { "type": "string" },
          "match": { "type": "array", "items": { "type": "string" } },
          "file_count": { "type": "integer", "minimum": 0 },
          "stats": { "$ref": "#/definitions/stats7" },
          "cov": { "$ref": "#/definitions/cov7" }
        }
      }
    }
  }
}
